/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AIPT ref-40 scoring profile
    Computes flexible per-chromosome episcore / zscore / ezscore for new samples
    using a precomputed ref-40 grid-search result, then plots score distributions.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    step = "aipt_ref_40"

    // Reference genome (for MethylDackel + SNP pileup)
    fasta       = "${projectDir}/assets/hg38_only_chromsomes.fa"
    fasta_index = "${projectDir}/assets/hg38_only_chromsomes.fa.fai"

    // SNP panel used for SNP-based fetal fraction (ff_before_mq)
    snp_list = "${projectDir}/assets/snps_in_220kprobes_v2.tsv"

    // Nested CpG recall lists (220k_cpg_recall_{recall}.txt) used by episcore + zscore
    cpg_recall_dir = "${projectDir}/assets/220k_cpg_recall_list"

    // Precomputed ref-40 grid-search result directory. Must contain:
    //   best_combo_episcore.csv, best_combo_zscore.csv, best_reference_matrix.tsv
    // Optional (when present, ezscore is computed and plotted):
    //   best_ezscore_ref_20_matrix.tsv, best_sample_scores_recalc_ezscore.tsv
    grid_search_result = "/lustre1/cqyi/AIPT_2.0/results/episcore_output/20260626-ref_40_flexible_combo_even_split"

    // Read-count zscore: minimum mTcount per read (matches workflow/zscore default)
    zscore_mtcount = 1

    // Episcore per-CpG depth filter. MethylDackel only reports covered CpGs
    // (depth >= 1), so 0 keeps every covered CpG, matching the grid search
    // (which applied no extra depth filter).
    beta_depth_threshold = 30

    // Positive-call cutoff drawn as a dotted line in the score plots
    score_cutoff = 3

    // SNP fetal-fraction estimation
    snp_depth_threshold = 30
    snp_est_mode        = "all"
    ff_precision        = 0.0001
}
